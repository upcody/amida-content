{
  "extends": ["ultracite"],
  "formatter": {
    "lineWidth": 120,
    "attributePosition": "auto",
    "useEditorconfig": true,
  },
  "javascript": {
    "parser": {
      "unsafeParameterDecoratorsEnabled": true,
    },
    "formatter": {
      "quoteStyle": "double",
      "jsxQuoteStyle": "double",
      "bracketSameLine": true,
      "arrowParentheses": "asNeeded",
    },
    "globals": ["Bun"],
  },
  "json": {
    "parser": {
      "allowComments": true,
    },
    "formatter": {
      "lineWidth": 120,
      "trailingCommas": "all",
    },
  },
  "css": {
    "formatter": {
      "lineWidth": 120,
    },
  },
  "linter": {
    "domains": {
      "next": "all",
      "project": "all",
      "react": "all",
      "test": "all",
    },
    "rules": {
      "a11y": {
        "useButtonType": "off",
      },
      "correctness": {
        "noUnknownFunction": "off",
      },
      "suspicious": {
        "noAssignInExpressions": "off",
        "noConsole": "off",
        "noConstEnum": "off",
        "noExplicitAny": "off",
      },
      "performance": {
        "useTopLevelRegex": "off",
      },
      "nursery": {
        "noAwaitInLoop": "off",
        "noUnknownAtRule": "off",
        "useSortedClasses": "off",
        "useExhaustiveSwitchCases": "off",
      },
      "style": {
        "noNestedTernary": "off",
        "noNonNullAssertion": "off",
        "noParameterProperties": "off",
        "useBlockStatements": "off",
        "useDefaultSwitchClause": "off",
        "useImportType": "off",
      },
    },
  },
  "assist": {
    "actions": {
      "source": {
        "useSortedKeys": "off",
        "useSortedAttributes": "off",
      },
    },
  },
}
